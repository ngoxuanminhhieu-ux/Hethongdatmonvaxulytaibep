  "item": [
    {
      "name": "1. Doctors & TimeSlots",
      "item": [
        {
          "name": "1.1 Get All Doctors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array of doctors', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    pm.expect(json.length).to.be.above(0);",
                  "    if (json.length > 0) {",
                  "        pm.collectionVariables.set('doctorId', json[0].id);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Filter Doctors by Specialty",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors?specialty=Tim mạch",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors"],
              "query": [
                {
                  "key": "specialty",
                  "value": "Tim mạch"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('All returned doctors have specialty Tim mach', function () {",
                  "    var json = pm.response.json();",
                  "    json.forEach(function(d) {",
                  "        pm.expect(d.specialty.toLowerCase()).to.include('tim');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Get Doctor Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{doctorId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Doctor object has required fields', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('name');",
                  "    pm.expect(json).to.have.property('roomNumber');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Get Doctor Time Slots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{doctorId}}/slots",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{doctorId}}", "slots"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Slots array returned with availability', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    if (json.length > 0) {",
                  "        pm.collectionVariables.set('slotId', json[0].id);",
                  "        pm.expect(json[0]).to.have.property('availableSpots');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Create New Doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"BS. CKII Đặng Minh Trí\",\n  \"specialty\": \"Chấn thương chỉnh hình\",\n  \"roomNumber\": \"P.502\",\n  \"phone\": \"0944556677\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Doctor created has ID', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Appointments",
      "item": [
        {
          "name": "2.1 Create Appointment (Book Slot & Request Queue Number)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Trần Hoàng Long\",\n  \"phone\": \"0988776655\",\n  \"identityNumber\": \"079200004321\",\n  \"dateOfBirth\": \"1992-08-20\",\n  \"gender\": \"Nam\",\n  \"doctorId\": {{doctorId}},\n  \"timeSlotId\": {{slotId}},\n  \"symptoms\": \"Đau thắt ngực khi leo cầu thang\",\n  \"notes\": \"Bệnh nhân tiền sử hen phế quản nhẹ\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.test('Status is Pending', function () { pm.expect(json.status).to.eql('Pending'); });",
                  "pm.collectionVariables.set('appointmentId', json.appointmentId);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Get Appointment Detail & History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{appointmentId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Contains history timeline', function () {",
                  "    pm.expect(json).to.have.property('history');",
                  "    pm.expect(json.history).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Cancel Appointment",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}?reason=Bận đột xuất",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{appointmentId}}"],
              "query": [
                {
                  "key": "reason",
                  "value": "Bận đột xuất"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Cancelled status confirmed', function () { pm.expect(json.status).to.eql('Cancelled'); });"
                ]
              }
            }
          ]
        }
      ]
    },
