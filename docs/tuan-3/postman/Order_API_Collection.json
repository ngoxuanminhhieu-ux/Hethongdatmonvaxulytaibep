		{
			"name": "2. Order Management (Quản lý đơn hàng)",
			"item": [
				{
					"name": "POST /api/orders - Tạo đơn đặt món hợp lệ (Success)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Order contains valid OrderId and TotalAmount\", function () {",
									"    pm.expect(jsonData.orderId).to.be.a('string');",
									"    pm.expect(jsonData.totalAmount).to.be.above(0);",
									"    pm.expect(jsonData.status).to.eql(\"Pending\");",
									"});",
									"if (jsonData.orderId) {",
									"    pm.collectionVariables.set(\"currentOrderId\", jsonData.orderId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerName\": \"Nguyễn Văn An\",\n  \"phone\": \"0901234567\",\n  \"tableNumber\": \"Bàn 01\",\n  \"notes\": \"Cho nhiều chanh và tương ớt\",\n  \"items\": [\n    {\n      \"menuItemId\": 1,\n      \"quantity\": 2,\n      \"notes\": \"1 tô không hành, 1 tô bình thường\"\n    },\n    {\n      \"menuItemId\": 6,\n      \"quantity\": 1,\n      \"notes\": \"Ít ngọt, nhiều đá\"\n    }\n  ]\n}"
						},
